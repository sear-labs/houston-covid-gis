      "popupInfo" : {
        "type" : "CIMPopupInfo",
        "title" : "{COUNTY}, {STATE}",
        "expressionInfos" : [
          {
            "type" : "CIMExpressionInfo",
            "title" : "Pop-up text",
            "expression" : "/* filter down to all counties within given state */\nvar current_state = $feature.STATE\nvar total_counties = filter($layer,\"STATE LIKE @current_state\")\n//return total_counties  /*works!*/\n\n/* pop-up text */\n\nif ($feature.county_ranked == 1) {\n return \"Out of all \" + sum(total_counties,'county_ranked') + \n    \" ranked counties in \" + $feature.STATE +\", \" + $feature.COUNTY + \n    \" County ranked number \" + $feature.Health_Outcomes_Rank + \n    \" in health outcomes and number \" +$feature.Health_Factors_Rank+ \n    \" in health factors.\"\n } \nelse {\n    return $feature.COUNTY +\" County was not ranked due to limited data.\"\n}\n\n\n",
            "name" : "expr0",
            "returnType" : "String"
          }
        ],
        "mediaInfos" : [
